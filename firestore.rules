rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }
    
    // Helper function for users collection - can read own document or if admin
    function canReadUser(uid) {
      return isSignedIn() && (
        request.auth.uid == uid || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isAdmin() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; 
    }
    
    function isApproved() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked != true;
    }

    // ========== USERS COLLECTION - LOCKED DOWN ==========
    // Users can read own doc
    // Users CANNOT change: role, approved, devices, blocked
    // Only admin can: approve users, approve devices, block users
    // =====================================================
    match /users/{uid} {
      allow read: if canReadUser(uid);
      
      // User can update ONLY safe fields (NOT role, approved, devices, blocked)
      allow update: if isAdmin() || (isSelf(uid) && userOnlyUpdatingSafeFields());
      
      // Users are created via Cloud Functions ONLY
      allow create: if false;
      
      // Users cannot be deleted
      allow delete: if false;
    }
    
    // CRITICAL: Define which fields users can modify on their own document
    function userOnlyUpdatingSafeFields() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      
      // PROTECTED FIELDS - users can NEVER change these
      // role, approved, devices, blocked - only admin/server can change
      let protectedFields = ['role', 'approved', 'devices', 'blocked', 'createdAt', 'email'];
      
      // ALLOWED FIELDS - users can change these on their own document
      let allowedSelfUpdates = [
        'lastLogin',           // Updated on login
        'screenshotAttempts',  // Violation tracking
        'lastViolation',       // Violation tracking
        'violations',          // Violation log
        'themePreference',     // User preference
        'notificationsEnabled', // User preference
        'name',                // Profile update
        'photoUrl',            // Profile update
        'fcmToken',            // Push notification token
        'fcmTokenUpdatedAt'    // Token refresh timestamp
      ];
      
      // Ensure NO protected fields are being modified
      return !affectedKeys.hasAny(protectedFields) && affectedKeys.hasOnly(allowedSelfUpdates);
    }

    // ========== LOGIN REQUESTS - DEVICE APPROVAL ==========
    match /login_requests/{requestId} {
      // Users can create login requests for themselves only
      allow create: if isSignedIn() && 
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status == 'pending';
      
      // Users can read their own login requests
      allow read: if isSignedIn() && (
                    resource.data.userId == request.auth.uid || isAdmin()
                  );
      
      // Only admin can update (approve/reject) or delete
      allow update, delete: if isAdmin();
    }

    // Folders - all approved users can CRUD (nested folder support)
    match /folders/{folderId} {
      allow read: if isApproved();
      allow create: if isApproved() && 
                    request.resource.data.createdBy == request.auth.uid &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 100;
      // Update: name + icon + updatedAt allowed. parentId + createdBy + createdAt are immutable.
      allow update: if isApproved() &&
                    request.resource.data.name is string &&
                    request.resource.data.name.size() > 0 &&
                    request.resource.data.name.size() <= 100 &&
                    request.resource.data.createdBy == resource.data.createdBy &&
                    request.resource.data.createdAt == resource.data.createdAt &&
                    request.resource.data.parentId == resource.data.parentId;
      allow delete: if isApproved() || isAdmin();
    }

    // Documents - all approved users can CRUD
    // storagePath, uploadedBy, uploadedAt are immutable after creation.
    match /documents/{documentId} {
      allow read: if isApproved();
      allow create: if isApproved() &&
                    request.resource.data.uploadedBy == request.auth.uid &&
                    request.resource.data.fileName is string &&
                    request.resource.data.fileName.size() > 0 &&
                    request.resource.data.folderId is string &&
                    request.resource.data.storagePath is string;
      // Update: fileName, updatedAt, downloadUrl allowed. storagePath + uploadedBy + uploadedAt immutable.
      allow update: if isApproved() &&
                    request.resource.data.storagePath == resource.data.storagePath &&
                    request.resource.data.uploadedBy == resource.data.uploadedBy &&
                    request.resource.data.uploadedAt == resource.data.uploadedAt;
      allow delete: if isApproved() || isAdmin();
    }

    // Team Chat - single group chat with messages subcollection
    // readBy is a map of userId -> timestamp for accurate read tracking
    match /chats/team_chat {
      allow read: if isApproved();
      
      match /messages/{messageId} {
        allow read: if isApproved();
        
        // Create: User can create message with empty readBy map
        allow create: if isApproved() &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.senderName is string &&
                      request.resource.data.senderName.size() > 0 &&
                      request.resource.data.senderRole in ['admin', 'member'] &&
                      request.resource.data.messageType in ['text', 'file'] &&
                      request.resource.data.content is string &&
                      request.resource.data.content.size() > 0 &&
                      (request.resource.data.messageType == 'text' ? 
                        request.resource.data.content.size() <= 1000 : true) &&
                      request.resource.data.readBy is map &&
                      request.resource.data.createdAt == request.time;
        
        // Update: User can ONLY add their own userId to readBy map
        // We allow the update if only readBy field is changing
        allow update: if isApproved() &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        
        // Delete: Messages cannot be deleted (immutability for audit trail)
        allow delete: if false;
      }
    }

    // Presence tracking for online users
    match /presence/{userId} {
      allow read: if isApproved();
      allow write: if isSignedIn() && userId == request.auth.uid;
    }

    // Announcements - all approved users can read and create, any approved user can edit
    // IMPORTANT: This is a collaborative system - any approved member can create/edit announcements
    // readBy is now a map of userId -> timestamp for accurate read tracking
    match /announcements/{announcementId} {
      allow read: if isApproved();
      
      // Create: Any approved user can create announcements
      allow create: if isApproved() &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0 &&
                    request.resource.data.title.size() <= 200 &&
                    request.resource.data.description is string &&
                    request.resource.data.description.size() > 0 &&
                    request.resource.data.type in ['normal', 'important', 'urgent'] &&
                    request.resource.data.actionRequired is bool &&
                    request.resource.data.createdBy == request.auth.uid &&
                    request.resource.data.createdByName is string &&
                    request.resource.data.readBy is map;
      
      // Update: Either mark as read OR edit content
      allow update: if isApproved() && (
                    // Option 1: User can add their userId to readBy map
                    // Only readBy field is changing
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])) ||
                    
                    // Option 2: Any approved member can edit announcement content
                    // Protected fields (createdBy, createdByName, createdAt, readBy) must not change
                    (request.resource.data.createdBy == resource.data.createdBy &&
                     request.resource.data.createdByName == resource.data.createdByName &&
                     request.resource.data.createdAt == resource.data.createdAt &&
                     request.resource.data.readBy == resource.data.readBy &&
                     request.resource.data.title is string &&
                     request.resource.data.title.size() > 0 &&
                     request.resource.data.description is string &&
                     request.resource.data.description.size() > 0 &&
                     request.resource.data.type in ['normal', 'important', 'urgent'] &&
                     request.resource.data.actionRequired is bool)
                   );
      
      // Delete: Announcements cannot be deleted (data immutability for audit trail)
      allow delete: if false;
    }
  }
}
